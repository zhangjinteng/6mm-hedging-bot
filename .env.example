# HTTP 管理接口监听地址；后台 REST API 会走这个端口。
HTTP_ADDR=:7892

# gRPC 内部服务监听地址；内部服务调用走这个端口。
GRPC_ADDR=:7893

# PostgreSQL 连接地址；本地复制为 .env 后把 change-me 改成真实密码。
DATABASE_URL=postgres://platform_admin_user:change-me@127.0.0.1:5432/platform_admin?sslmode=disable

# 交易对白名单来源库；只读取 public.symbol_config，用于过滤写入 exchange_markets 的交易对。
# 也可以改用 SYMBOL_CONFIG_DATABASE_URL=postgres://freedex_app:change-me@127.0.0.1:5432/freedex?sslmode=disable
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=freedex
DB_USERNAME=freedex_app
DB_PASSWORD=change-me
DB_CONNECT_TIMEOUT=5

# 交易所凭证 AES-256-GCM 密钥。需与 agent_admin 的 HEDGING_CREDENTIAL_KEY
# 完全一致；使用 base64 编码的 32 字节随机值。
HEDGING_CREDENTIAL_KEY=

# 启动时是否自动执行 internal/db/migrations 下的数据库迁移。
RUN_MIGRATIONS=true

# 数据库迁移 SQL 文件目录。
MIGRATIONS_DIR=internal/db/migrations

# 交易所适配器。
# simulated：本地模拟下单，不触达真实交易所。
# ccxt：通过 CCXT 连接交易所 API；交易环境统一由 EXCHANGE_ENV 控制。
# Binance Demo、Bybit Testnet、Bitget Demo/Paper、OKX Demo 都必须使用对应测试/模拟环境创建的 API Key。
# 请求里的 account.sandbox 只保留为展示和兼容字段，不作为最终环境开关。
# 注意：CCXT 适配器通过 //go:build ccxt 启用；make run 会在 EXCHANGE_ADAPTER=ccxt 时自动带上 -tags ccxt。
EXCHANGE_ADAPTER=ccxt

# 交易环境：paper=测试网/模拟盘，live=正式环境。
# paper 只切换交易所环境，API Key 仍要使用对应交易所的测试网/模拟盘 Key。
# Bitget paper 推荐使用 Demo/Paper API Key + USDT-FUTURES；不要拿实盘 Key 请求 paper。
# CCXT 适配器以这里为准，接口请求里的 account.sandbox 不会覆盖这个全局环境。
EXCHANGE_ENV=paper

# 收到退出信号后等待 HTTP/gRPC/worker 优雅关闭的最长时间。
SHUTDOWN_TIMEOUT=10s

# 日志输出位置：console=控制台，file=文件，both=控制台和文件。
LOG_OUTPUT=both
LOG_FILE=logs/hedging-bot.log

# 日志最低级别与输出格式；格式支持 json 或 console。
LOG_LEVEL=info
LOG_FORMAT=json

# Redis 地址；用于分布式锁、Asynq 队列和定时任务。
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 是否启动 Asynq worker 处理异步对冲任务。worker 并发数。
WORKER_ENABLED=true
WORKER_CONCURRENCY=5

# 是否启动定时调度；默认关闭，避免本地启动后自动跑任务。
SCHEDULER_ENABLED=false

# 定时调度间隔；SCHEDULER_ENABLED=true 时生效。
HEDGE_SCHEDULE_INTERVAL=1m

# 单个对冲配置的分布式执行锁 TTL，防止异常退出后锁永久残留。
HEDGE_RUN_LOCK_TTL=3m

# 订单成交后的自动对冲冷却期，等待交易所仓位同步完成。
HEDGE_RUN_COOLDOWN=10s

# 是否启动交易对定时同步；会读取启用的 exchange_accounts，并写入 exchange_markets。
MARKET_SYNC_ENABLED=true

# 交易对同步间隔；MARKET_SYNC_ENABLED=true 时生效。
MARKET_SYNC_INTERVAL=6h

# 是否启动上游敞口同步；独立于 SCHEDULER_ENABLED。
# 启用后会聚合 ClickHouse current_position_query、读取 Redis 标记价、更新 exposure_snapshots，
# 并将对应配置提交到现有 Asynq hedge:run 队列。
EXPOSURE_SYNC_ENABLED=false

# 上游敞口同步间隔。建议不小于 Asynq 任务去重窗口（当前为 30 秒）。
EXPOSURE_SYNC_INTERVAL=30s

# ClickHouse 历史库 HTTP 连接；只读 current_position_query。
CLICKHOUSE_HISTORY_HOST=127.0.0.1
CLICKHOUSE_HISTORY_HTTP_PORT=8123
CLICKHOUSE_HISTORY_DATABASE=freedex_history
CLICKHOUSE_HISTORY_USERNAME=history_readonly
CLICKHOUSE_HISTORY_PASSWORD=change-me
CLICKHOUSE_HISTORY_CONNECT_TIMEOUT=5
CLICKHOUSE_HISTORY_TIMEOUT=30

# 标记价最大允许延迟；超过该时间不会更新快照或触发对冲。
EXPOSURE_PRICE_MAX_AGE=2m

# Redis 净敞口热缓存有效期及键前缀。
EXPOSURE_CACHE_TTL=2m
MARKET_PRICE_KEY_PREFIX=market_price:6mm:
EXPOSURE_CACHE_KEY_PREFIX=hedge:exposure:6mm:

# 是否定时从已配置的活跃交易所账户批量同步真实仓位；独立于 SCHEDULER_ENABLED。
# 与币种对冲开关解耦：币种关闭后仍会同步残留仓位，供敞口监控使用。
POSITION_SYNC_ENABLED=true

# 交易所仓位同步间隔；POSITION_SYNC_ENABLED=true 时生效。
POSITION_SYNC_INTERVAL=10s

# 仓位快照超过该时间未刷新时，敞口监控状态显示为“观察中”。
POSITION_STALE_AFTER=1m

# TRON 链配置 (Nile 测试网, 切主网时替换)
TRON_GRID_API='https://nile.trongrid.io'
TRON_GRPC='grpc.nile.trongrid.io:50051'
TRON_USDT_CONTRACT='TJBoTT7Va39vwjeZx2dQkfqXQDcUrKPbJw'
TRON_EXPLORER_URL='https://nile.tronscan.org/#/transaction/'
DEPOSIT_EVENT_STREAM=agent:deposit:events
# 数据库
FREEDEX_DB='host=127.0.0.1 port=5432 user=postgres password=change-me dbname=freedex sslmode=disable TimeZone=Asia/Shanghai'
